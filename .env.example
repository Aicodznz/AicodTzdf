# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OILCOM_HMAC_SECRET: Server-side secret for signing Loyalty QR tokens and Payment Sandbox callbacks.
# Leave unset in dev to auto-generate a secure ephemeral per-process secret.
OILCOM_HMAC_SECRET="CHANGE_ME_IN_PRODUCTION"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform browser API key (optional override).
VITE_GOOGLE_MAPS_API_KEY=""
